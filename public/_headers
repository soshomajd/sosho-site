# Cloudflare Workers Assets header rules.
# https://developers.cloudflare.com/workers/static-assets/headers/
#
# These rules apply to responses the asset server returns directly, which covers
# every static file and every pre-rendered HTML page. They do NOT apply to
# responses generated inside worker/index.js (/api/*, the `/` redirect, the
# locale redirects) - those set their own headers there.
#
# The static export copies public/ into out/, and scripts/build-sites.mjs copies
# out/ into dist/client, so this file ships as dist/client/_headers.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://d2ol7oe51mr4n9.cloudfront.net; font-src 'self' data:; connect-src 'self'; media-src 'self' blob: https://d8j0ntlcm91z4.cloudfront.net; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# Content-hashed bundles never change under the same URL, so cache them forever
# instead of the asset server default of `public, max-age=0, must-revalidate`.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts never change under the same name; rename the file when replacing a font.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Article art and project images may be regenerated under the same name.
/blog/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/projects/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/og.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

# Admin dashboard: never indexed, never cached anywhere.
/admin
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

/admin/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store
