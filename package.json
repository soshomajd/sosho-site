{
  "name": "sosho-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:next": "next dev",
    "dev:worker": "wrangler dev --config wrangler.dev.jsonc --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.dev.jsonc",
    "db:migrate:staging": "wrangler d1 migrations apply sosho-sales-staging --remote --config wrangler.staging.jsonc",
    "build": "npm run build:sites",
    "build:next": "next build",
    "build:sites": "node scripts/build-sites.mjs",
    "blog:cover": "node scripts/generate-cover.mjs",
    "deploy": "npm run build:sites && wrangler deploy",
    "deploy:staging": "npm run build:sites && wrangler deploy --config wrangler.staging.jsonc",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.2",
    "@vercel/speed-insights": "^1.3.1",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.5.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@msw/cloudflare": "^0.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.2",
    "msw": "^2.14.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.0",
    "wrangler": "^4.124.0"
  },
  "displayName": "SoSho Studio AI Sales"
}
