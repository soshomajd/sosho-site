{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sosho-site",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-08-20",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sosho-sales",
      "database_id": "76f1648b-b8b8-44a4-8ed3-1e01e68db5b3",
      "migrations_dir": "db/migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_SITE_ORIGINS": "https://sosho-studio.net,https://www.sosho-studio.net",
    "CONTENT_AI_PROVIDER": "workers_ai",
    "WORKERS_AI_CONTENT_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
    "WORKERS_AI_FALLBACK_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "IMAGE_AI_PROVIDER": "workers_ai",
    "WORKERS_AI_IMAGE_MODEL": "@cf/black-forest-labs/flux-1-schnell",
    "IMAGE_AI_TIMEOUT_MS": "60000",
    "IMAGE_MAX_BYTES": "5000000",
    "ARVAN_S3_ENDPOINT": "https://s3.ir-thr-at1.arvanstorage.ir",
    "ARVAN_S3_BUCKET": "soshosite",
    "OPENAI_MODEL": "gpt-5.6-luna",
    "META_GRAPH_VERSION": "v26.0",
    "INSTAGRAM_DEFAULT_LOCALE": "fa",
    "CHAT_IP_HOURLY_LIMIT": "60",
    "CHAT_CONVERSATION_HOURLY_LIMIT": "30",
    "INSTAGRAM_USER_HOURLY_LIMIT": "30",
    "OPENAI_HOURLY_LIMIT": "100",
    "OPENAI_DAILY_LIMIT": "500",
    "OPENAI_MAX_OUTPUT_TOKENS": "1200",
    "CONTENT_OPENAI_MAX_OUTPUT_TOKENS": "6000",
    "TELEGRAM_TIMEOUT_MS": "5000",
    "TELEGRAM_MAX_ATTEMPTS": "3",
    "OPENAI_TIMEOUT_MS": "8000",
    "OPENAI_MAX_ATTEMPTS": "3",
    "META_TIMEOUT_MS": "8000",
    "META_MAX_ATTEMPTS": "3",
    "RETRY_BASE_DELAY_MS": "250",
    "WEBHOOK_MAX_ATTEMPTS": "8",
    "WEBHOOK_RETRY_BASE_SECONDS": "60",
    "WEBHOOK_PROCESSING_TIMEOUT_SECONDS": "120",
    "MESSAGE_RETENTION_DAYS": "180",
    "LEAD_PII_RETENTION_DAYS": "365",
    "WEBHOOK_PAYLOAD_RETENTION_DAYS": "7",
    "WEBHOOK_EVENT_RETENTION_DAYS": "90"
  },
  "triggers": {
    "crons": ["*/5 * * * *", "15 3 * * *"]
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/"]
  },
  "routes": [
    { "pattern": "sosho-studio.net", "custom_domain": true },
    { "pattern": "www.sosho-studio.net", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
