{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sosho-site",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-08-20",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/"]
  },
  "routes": [
    { "pattern": "sosho-studio.net", "custom_domain": true },
    { "pattern": "www.sosho-studio.net", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
